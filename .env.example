# SRI-KO LMS — infrastructure environment template
#
# Copy to .env and fill in. .env is git-ignored and must stay that way: §7 is
# unconditional — no secret is committed, even to a private repository.
#
#   cp .env.example .env
#
# In CI and on the deployment hosts these values come from GitHub Actions
# secrets and are written to the host with mode 600 by the deploy action. This
# file exists so that (a) a new developer knows which keys are needed, and
# (b) `docker compose config` can validate the compose files without anyone
# having real credentials — every value below is a placeholder, and several of
# the compose files will refuse to start with them.
#
# Generate the three secrets with:
#   openssl rand -base64 48

# ── Database ────────────────────────────────────────────────────────────────

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_DATABASE=sriko_lms

# The application connects as this user, which has readWrite on one database
# and nothing else. Connecting as root works and is what most examples do; it
# also means an injection bug can drop every database on the server.
MONGO_APP_USERNAME=sriko_app
MONGO_APP_PASSWORD=change-me-app-password

MONGO_PORT=27017

# Production only. The production stack has no MongoDB container — it points at
# managed MongoDB, which has the replica set, the backups and the monitoring a
# compose-managed container on one host does not.
#
# Left set to a placeholder rather than commented out, because
# docker-compose.prod.yml declares it `${MONGODB_URI:?}` and `npm run validate`
# resolves every stack against this file. A commented-out required variable
# makes the validation fail on a file that is actually correct.
MONGODB_URI=mongodb+srv://REPLACE_ME:REPLACE_ME@cluster.example.mongodb.net/sriko_lms?retryWrites=true&w=majority

# ── Application ─────────────────────────────────────────────────────────────

# Signs every access token. A deployment that leaves this unset falls back to a
# constant published in the application source (DEFECT-03) and every token
# becomes forgeable — so it is a required variable in every compose file here.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRE=7d

SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Public. Safe to commit in principle; kept here so one file describes the
# whole configuration.
GOOGLE_CLIENT_ID=

LOG_LEVEL=debug

# ── Images ──────────────────────────────────────────────────────────────────

BACKEND_IMAGE=teamnova/sri-ko-lms-backend
FRONTEND_IMAGE=teamnova/sri-ko-lms-frontend

# Use an immutable tag in staging and production — a version, or sha-<commit>.
# A moving tag like `latest` cannot be rolled back to, because it points
# somewhere else by the time anyone tries.
IMAGE_TAG=develop

# ── Ports ───────────────────────────────────────────────────────────────────

API_PORT=5001
WEB_PORT=5173

# ── Local build ─────────────────────────────────────────────────────────────

# Which application checkout to build, and how its source directories are
# named. These three move together — a path from one repository with the
# casing from the other produces "package.json not found", which says nothing
# about which half is wrong.
#
# Relative paths are resolved from the Compose project directory, which is
# `compose/` — hence three levels up to reach the workspace root.
#
#   TeamNova-SRI-KO-LMS/app        backend/  frontend/   ← the organisation's repo
#   SRI-KO_LMS_MERN                Backend/  Frontend/   ← the full application
#
APP_PATH=../../../SRI-KO_Application_Project/app
BACKEND_DIR=backend
FRONTEND_DIR=frontend

# For the SRI-KO_LMS_MERN checkout instead:
# APP_PATH=../../../SRI-KO_Application_Project/SRI-KO_LMS_MERN
# BACKEND_DIR=Backend
# FRONTEND_DIR=Frontend

# Absolute path to this repository. Only needed when running compose from
# somewhere other than the repository root — see the note in
# compose/docker-compose.yml.
# INFRA_ROOT=

# ── Scaling (production) ────────────────────────────────────────────────────

API_REPLICAS=2
WEB_REPLICAS=2

# ── Backups ─────────────────────────────────────────────────────────────────

BACKUP_DIR=/opt/sri-ko-lms/backups
RETENTION_DAYS=14
# A backup that lives only on the host it protects is not a backup.
# BACKUP_S3_BUCKET=
